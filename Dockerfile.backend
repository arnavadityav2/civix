FROM python:3.12-slim

# System dependencies for PostGIS, GDAL, and PostgreSQL client
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gdal-bin \
    libgdal-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source directories
COPY civix_api /app/civix_api
COPY civix_generator /app/civix_generator
COPY models /app/models
COPY data /app/data
COPY scripts /app/scripts
COPY scratch /app/scratch

# Set Python Path & environment defaults
ENV PYTHONPATH=/app
ENV CIVIX_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8000

EXPOSE 8000

# Start Uvicorn Async FastAPI Server
CMD ["python", "-m", "uvicorn", "civix_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
