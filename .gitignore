__pycache__/
*.py[cod]
*$py.class
*.egg-info/
output/
output_run1/
.env
.pytest_cache/
.vscode/
.idea/

# Ignore massive datasets if accidentally copied into the workspace
civix_data/
*.parquet

# Ignore large model binaries (allow trained CIVIX model files)
*.pkl
!models/**/*.pkl
*.pt
!models/**/*.pt
*.pth
*.joblib
*.onnx

# Explicit exceptions to ensure we never ignore ML code/metadata
!civix_ml/
!civix_generator/
!docs/
!scratch/
!scripts/
!models/metadata/
!*.json

# Ignore temporary local binaries inside scratch or frontend
scratch/neo4j/
scratch/neo4j_demo/
node_modules/
frontend/node_modules/
.env.local
.env.demo
.env.test
*.ps1

# Ignore temporary output datasets and local stores
demo_output/
demo_world/
demo_world_15k_output/
civix_cctv_artifacts/
civix_evidence_store/
civix_golden_evidence/
validation/
*.txt
!requirements.txt
!README.md
!AGENTS.md